<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AtamanAssistant.ViewModels"
             xmlns:views="using:AtamanAssistant.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="AtamanAssistant.Views.ShellView"
             x:DataType="vm:MainViewModel">
  <TabControl Margin="8">
    <TabItem Header="Asistan">
      <views:MainView DataContext="{Binding}" />
    </TabItem>
    <TabItem Header="Ayarlar">
      <views:SettingsView DataContext="{Binding Settings}" />
    </TabItem>
  </TabControl>
</UserControl>