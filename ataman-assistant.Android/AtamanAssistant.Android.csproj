<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>com.CompanyName.ataman_assistant</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AtamanAssistant.Android</AssemblyName>
    <RootNamespace>AtamanAssistant.Android</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <!--
    Native libraries produced by build\native\build-android-libs.ps1.
    Kept conditional: once the .so files exist under libs/<abi>/ they are
    packaged automatically without further changes.
  -->
  <ItemGroup Condition="Exists('libs\arm64-v8a\libllama.so')">
    <AndroidNativeLibrary Include="libs\arm64-v8a\libllama.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('libs\arm64-v8a\libggml.so')">
    <AndroidNativeLibrary Include="libs\arm64-v8a\libggml.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('libs\arm64-v8a\libggml-base.so')">
    <AndroidNativeLibrary Include="libs\arm64-v8a\libggml-base.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('libs\arm64-v8a\libggml-cpu.so')">
    <AndroidNativeLibrary Include="libs\arm64-v8a\libggml-cpu.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('libs\arm64-v8a\libjllama.so')">
    <AndroidNativeLibrary Include="libs\arm64-v8a\libjllama.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('libs\arm64-v8a\libvosk.so')">
    <AndroidNativeLibrary Include="libs\arm64-v8a\libvosk.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('libs\arm64-v8a\libc++_shared.so')">
    <AndroidNativeLibrary Include="libs\arm64-v8a\libc++_shared.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('libs\arm64-v8a\libonnxruntime.so')">
    <AndroidNativeLibrary Include="libs\arm64-v8a\libonnxruntime.so" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ataman-assistant\AtamanAssistant.csproj" />
  </ItemGroup>

</Project>